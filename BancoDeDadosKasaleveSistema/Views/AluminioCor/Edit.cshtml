@model BancoDeDadosKasaleveSistema.Models.AluminioCor
@{ ViewData["Title"] = "Editar AluminioCor"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="AluminioCorId" />
    <div class="mb-3"><label asp-for="CorAluminioCor" class="form-label"></label>
        <input asp-for="CorAluminioCor" class="form-control" />
        <span asp-validation-for="CorAluminioCor" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="SKUAluminioCor" class="form-label"></label>
        <input asp-for="SKUAluminioCor" class="form-control" />
        <span asp-validation-for="SKUAluminioCor" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="HexCor" class="form-label"></label>
        <input asp-for="HexCor" class="form-control" />
        <span asp-validation-for="HexCor" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
