@model BancoDeDadosKasaleveSistema.Models.Categoria
@{ ViewData["Title"] = "Cadastrar Categoria"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="CategoriaNome" class="form-label"></label>
        <input asp-for="CategoriaNome" class="form-control" />
        <span asp-validation-for="CategoriaNome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="CategoriaDescricao" class="form-label"></label>
        <input asp-for="CategoriaDescricao" class="form-control" />
        <span asp-validation-for="CategoriaDescricao" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Ativo" class="form-label"></label>
        <input asp-for="Ativo" class="form-check-input" />
        <span asp-validation-for="Ativo" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
