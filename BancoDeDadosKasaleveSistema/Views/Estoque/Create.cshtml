@model BancoDeDadosKasaleveSistema.Models.Estoque
@{ ViewData["Title"] = "Cadastrar Estoque"; }
<h1>@ViewData["Title"]</h1>
<p>O saldo é atualizado somente por movimentações. Cadastre o estoque com saldo zero e registre uma entrada para informar o saldo inicial.</p>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="ProdutoVariacaoId" class="form-label"></label>
        <select asp-for="ProdutoVariacaoId" asp-items="@(ViewData["ProdutoVariacaoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="ProdutoVariacaoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Localizacao" class="form-label"></label>
        <input asp-for="Localizacao" class="form-control" />
        <span asp-validation-for="Localizacao" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="EstoqueMinimo" class="form-label"></label>
        <input asp-for="EstoqueMinimo" class="form-control" />
        <span asp-validation-for="EstoqueMinimo" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
