@model IEnumerable<BancoDeDadosKasaleveSistema.Models.Estoque>
@{ ViewData["Title"] = "Estoque por produto, cores e local"; }
<h1>Estoque por local</h1>
<p>Cada combinação de cores é uma variação. A mesma variação pode ter saldo na loja, no depósito e em outros locais.</p>
<p><a asp-action="Create" class="btn btn-primary">Cadastrar variação em um local</a> <a asp-controller="ProdutoVariacao" asp-action="Create" class="btn btn-outline-secondary">Nova combinação de cores</a></p>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Produto e cores</th><th>Local</th><th>Saldo</th><th>Mínimo</th><th>Ações</th></tr></thead><tbody>
@foreach(var item in Model)
{
<tr><td>@item.ProdutoVariacao?.DescricaoCompleta</td><td>@item.Localizacao</td><td>@item.Quantidade</td><td>@item.EstoqueMinimo</td><td>
<a asp-controller="MovimentacaoEstoque" asp-action="Create" asp-route-estoqueId="@item.EstoqueId">Entrada / saída</a> |
<a asp-controller="MovimentacaoEstoque" asp-action="Transferir" asp-route-estoqueId="@item.EstoqueId">Transferir</a> |
<a asp-controller="MovimentacaoEstoque" asp-action="Index" asp-route-estoqueId="@item.EstoqueId">Histórico</a> |
<a asp-action="Edit" asp-route-id="@item.EstoqueId">Editar mínimo</a> |
<a asp-action="Details" asp-route-id="@item.EstoqueId">Detalhes</a> |
<a asp-action="Delete" asp-route-id="@item.EstoqueId">Excluir</a>
</td></tr>
}
@if(!Model.Any()) { <tr><td colspan="5">Nenhum estoque cadastrado. Cadastre primeiro o produto e sua combinação de cores.</td></tr> }
</tbody></table></div>
