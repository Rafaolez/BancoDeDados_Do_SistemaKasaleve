@model IEnumerable<BancoDeDadosKasaleveSistema.Models.FibraCor>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Sku)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HexCor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Variacoes)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.Sku)
            </td>
            <td>
                @Html.DisplayFor(model => item.HexCor)
            </td>
            <td>
                @Html.DisplayFor(model => item.Variacoes)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FibraCorId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FibraCorId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FibraCorId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
