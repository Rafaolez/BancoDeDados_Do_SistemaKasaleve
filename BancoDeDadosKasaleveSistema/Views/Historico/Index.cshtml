@model IEnumerable<BancoDeDadosKasaleveSistema.Models.Historico>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UsuarioId)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Entidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EntidadeId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Acao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataHora)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.UsuarioId)
            </td>

            <td>
                @Html.DisplayFor(model => item.Entidade)
            </td>
            <td>
                @Html.DisplayFor(model => item.EntidadeId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Acao)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataHora)
            </td>
            <td>

                <a asp-action="Details" asp-route-id="@item.HistoricoId">Details</a> |
                </td>
        </tr>
}
    </tbody>
</table>
