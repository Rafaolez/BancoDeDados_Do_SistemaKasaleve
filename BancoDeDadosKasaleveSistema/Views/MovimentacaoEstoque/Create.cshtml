@model BancoDeDadosKasaleveSistema.ViewModels.MovimentacaoEstoqueForm
@{ ViewData["Title"] = "Registrar movimentação"; }
<h1>Registrar movimentação</h1>
<p>O saldo será calculado ao salvar. Para corrigir uma movimentação, registre a operação inversa e informe o motivo e o número do registro original.</p>
<form asp-action="Create" method="post" class="col-md-6">
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="EstoqueId" class="form-label"></label><select asp-for="EstoqueId" asp-items="@(ViewData["EstoqueId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="EstoqueId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="TipoMovimentacaoId" class="form-label"></label><select asp-for="TipoMovimentacaoId" asp-items="@(ViewData["TipoMovimentacaoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="TipoMovimentacaoId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Quantidade" class="form-label"></label><input asp-for="Quantidade" class="form-control" /><span asp-validation-for="Quantidade" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Motivo" class="form-label"></label><input asp-for="Motivo" class="form-control" /><span asp-validation-for="Motivo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="OrcamentoId" class="form-label"></label><select asp-for="OrcamentoId" asp-items="@(ViewData["OrcamentoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Sem orçamento</option></select><span asp-validation-for="OrcamentoId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="UsuarioId" class="form-label"></label><select asp-for="UsuarioId" asp-items="@(ViewData["UsuarioId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select><span asp-validation-for="UsuarioId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Obs" class="form-label"></label><input asp-for="Obs" class="form-control" /><span asp-validation-for="Obs" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Registrar</button> <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
