@model BancoDeDadosKasaleveSistema.Models.MovimentacaoEstoque
@{ ViewData["Title"] = "Detalhes da movimentação"; }
<h1>Movimentação #@Model.MovimentacaoEstoqueId</h1>
<dl class="row">
<dt class="col-sm-3">Data</dt><dd class="col-sm-9">@Model.DataMovimentacao.ToString("dd/MM/yyyy HH:mm:ss")</dd>
<dt class="col-sm-3">Produto e cores</dt><dd class="col-sm-9">@(Model.DescricaoVariacao ?? Model.Estoque?.ProdutoVariacao?.Sku)</dd>
<dt class="col-sm-3">Tipo</dt><dd class="col-sm-9">@Model.TipoMovimentacao?.Nome</dd>
<dt class="col-sm-3">Quantidade</dt><dd class="col-sm-9">@Model.Quantidade</dd>
<dt class="col-sm-3">Saldo anterior → posterior</dt><dd class="col-sm-9">@Model.SaldoAnterior → @Model.SaldoPosterior</dd>
<dt class="col-sm-3">Motivo</dt><dd class="col-sm-9">@Model.Motivo</dd>
<dt class="col-sm-3">Responsável</dt><dd class="col-sm-9">@Model.Usuario?.Nome</dd>
<dt class="col-sm-3">Orçamento</dt><dd class="col-sm-9">@Model.OrcamentoId</dd>
<dt class="col-sm-3">Observações</dt><dd class="col-sm-9">@Model.Obs</dd>
<dt class="col-sm-3">Local no registro</dt><dd class="col-sm-9">@(Model.LocalizacaoRegistro ?? Model.Estoque?.Localizacao)</dd>
@if(Model.TransferenciaId.HasValue) { <dt class="col-sm-3">Transferência</dt><dd class="col-sm-9"><a asp-action="Index" asp-route-transferenciaId="@Model.TransferenciaId">Ver origem e destino</a></dd> }
</dl>
<a asp-action="Index" asp-route-estoqueId="@Model.EstoqueId" class="btn btn-outline-secondary">Voltar ao histórico</a>
