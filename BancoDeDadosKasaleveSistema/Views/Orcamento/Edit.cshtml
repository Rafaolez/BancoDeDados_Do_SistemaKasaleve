@model BancoDeDadosKasaleveSistema.Models.Orcamento
@{ ViewData["Title"] = "Editar Orcamento"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="OrcamentoId" />
    <div class="mb-3"><label asp-for="Validade" class="form-label"></label>
        <input asp-for="Validade" class="form-control" />
        <span asp-validation-for="Validade" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ClienteId" class="form-label"></label>
        <select asp-for="ClienteId" asp-items="@(ViewData["ClienteId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="ClienteId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="UsuarioId" class="form-label"></label>
        <select asp-for="UsuarioId" asp-items="@(ViewData["UsuarioId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="UsuarioId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="SubTotal" class="form-label"></label>
        <input asp-for="SubTotal" class="form-control" />
        <span asp-validation-for="SubTotal" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Desconto" class="form-label"></label>
        <input asp-for="Desconto" class="form-control" />
        <span asp-validation-for="Desconto" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Frete" class="form-label"></label>
        <input asp-for="Frete" class="form-control" />
        <span asp-validation-for="Frete" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Total" class="form-label"></label>
        <input asp-for="Total" class="form-control" />
        <span asp-validation-for="Total" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Obs" class="form-label"></label>
        <input asp-for="Obs" class="form-control" />
        <span asp-validation-for="Obs" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Status" class="form-label"></label>
        <input asp-for="Status" class="form-control" />
        <span asp-validation-for="Status" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
