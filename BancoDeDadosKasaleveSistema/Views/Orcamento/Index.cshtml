                @Html.DisplayFor(model => item.Total)
            </td>
            <td>
                @Html.DisplayFor(model => item.Obs)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataAlteracao)
            </td>


            <td>
                <a asp-action="Edit" asp-route-id="@item.OrcamentoId">Edit</a> |
