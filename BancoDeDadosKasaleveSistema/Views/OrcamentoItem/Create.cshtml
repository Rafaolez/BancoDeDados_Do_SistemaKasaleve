@model BancoDeDadosKasaleveSistema.Models.OrcamentoItem
@{ ViewData["Title"] = "Cadastrar OrcamentoItem"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="OrcamentoId" class="form-label"></label>
        <select asp-for="OrcamentoId" asp-items="@(ViewData["OrcamentoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="OrcamentoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ProdutoVariacaoId" class="form-label"></label>
        <select asp-for="ProdutoVariacaoId" asp-items="@(ViewData["ProdutoVariacaoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="ProdutoVariacaoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Quantidade" class="form-label"></label>
        <input asp-for="Quantidade" class="form-control" />
        <span asp-validation-for="Quantidade" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ValorUnitario" class="form-label"></label>
        <input asp-for="ValorUnitario" class="form-control" />
        <span asp-validation-for="ValorUnitario" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ValorExtra" class="form-label"></label>
        <input asp-for="ValorExtra" class="form-control" />
        <span asp-validation-for="ValorExtra" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Desconto" class="form-label"></label>
        <input asp-for="Desconto" class="form-control" />
        <span asp-validation-for="Desconto" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ValorTotal" class="form-label"></label>
        <input asp-for="ValorTotal" class="form-control" />
        <span asp-validation-for="ValorTotal" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Obs" class="form-label"></label>
        <input asp-for="Obs" class="form-control" />
        <span asp-validation-for="Obs" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="NomeProdutoSnapshot" class="form-label"></label>
        <input asp-for="NomeProdutoSnapshot" class="form-control" />
        <span asp-validation-for="NomeProdutoSnapshot" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
