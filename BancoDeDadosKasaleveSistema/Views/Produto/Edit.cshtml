@model BancoDeDadosKasaleveSistema.Models.Produto
@{ ViewData["Title"] = "Editar Produto"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProdutoId" />
    <div class="mb-3"><label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="@(ViewData["CategoriaId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
        <span asp-validation-for="Descricao" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ValorLogista" class="form-label"></label>
        <input asp-for="ValorLogista" class="form-control" />
        <span asp-validation-for="ValorLogista" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ValorFinal" class="form-label"></label>
        <input asp-for="ValorFinal" class="form-control" />
        <span asp-validation-for="ValorFinal" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Img" class="form-label"></label>
        <input asp-for="Img" class="form-control" />
        <span asp-validation-for="Img" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control" />
        <span asp-validation-for="Sku" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="EstoqueMinimo" class="form-label"></label>
        <input asp-for="EstoqueMinimo" class="form-control" />
        <span asp-validation-for="EstoqueMinimo" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Ativo" class="form-label"></label>
        <input asp-for="Ativo" class="form-check-input" />
        <span asp-validation-for="Ativo" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
