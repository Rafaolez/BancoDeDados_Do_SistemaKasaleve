@model BancoDeDadosKasaleveSistema.Models.ProdutoVariacao
@{ ViewData["Title"] = "Editar ProdutoVariacao"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="ProdutoVariacaoId" />
    <div class="mb-3"><label asp-for="ProdutoId" class="form-label"></label>
        <select asp-for="ProdutoId" asp-items="@(ViewData["ProdutoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="ProdutoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="AluminioCorId" class="form-label"></label>
        <select asp-for="AluminioCorId" asp-items="@(ViewData["AluminioCorId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="AluminioCorId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="CordaCorId" class="form-label"></label>
        <select asp-for="CordaCorId" asp-items="@(ViewData["CordaCorId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="CordaCorId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="FibraCorId" class="form-label"></label>
        <select asp-for="FibraCorId" asp-items="@(ViewData["FibraCorId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="FibraCorId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="TecidoId" class="form-label"></label>
        <select asp-for="TecidoId" asp-items="@(ViewData["TecidoId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList)" class="form-select"><option value="">Selecione</option></select>
        <span asp-validation-for="TecidoId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Sku" class="form-label"></label>
        <input asp-for="Sku" class="form-control" />
        <span asp-validation-for="Sku" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Ativo" class="form-label"></label>
        <input asp-for="Ativo" class="form-check-input" />
        <span asp-validation-for="Ativo" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
