@model IEnumerable<BancoDeDadosKasaleveSistema.Models.ProdutoVariacao>
@{ ViewData["Title"] = "Variações de produtos"; }
<h1>Variações de produtos</h1>
<p>Cadastre uma variação para cada combinação de produto, alumínio, corda, fibra e tecido.</p>
<a asp-action="Create" class="btn btn-primary mb-3">Nova combinação</a>
<table class="table table-striped"><thead><tr><th>Produto e cores</th><th>Ativo</th><th>Ações</th></tr></thead><tbody>
@foreach(var item in Model) { <tr><td>@item.DescricaoCompleta</td><td>@(item.Ativo ? "Sim" : "Não")</td><td>
<a asp-action="Edit" asp-route-id="@item.ProdutoVariacaoId">Editar</a> | <a asp-action="Details" asp-route-id="@item.ProdutoVariacaoId">Detalhes</a> | <a asp-controller="Estoque" asp-action="Create">Cadastrar estoque</a>
</td></tr> }
</tbody></table>
